<?xml version="1.0"?>
<configuration>
  <configSections>
    <sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
      <section name="IPA_Sorter.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
    </sectionGroup>
  </configSections>
  <appSettings>
    <add key="separator" value="," />
    
    <add key="fileExtension" value="ipa" />
    
    <add key="fileList" value="Payload/*.app/Info.plist,iTunesMetadata.plist" />
    <add key="suffixList" value="_Info|_Meta" />

    <add key="errorPrefix" value="_ERROR_" />

    <add key="patternDevices" value="UIDeviceFamily_1:iPhone|2:iPad_iP--" />

    <add key="patternIosX" value="X:1|4:2" />
    <add key="noCracker" value="[None]" />

    <add key="patternRename" value="#_APPNAME_:25# v#_VERSION_# (iOS#_IOS_#-#_DEVICES_#) by #_CRACKER_#" />
    <add key="patternSort" value="Apps iOS #_IOSX_# #_DEVICES_#" />

    <add key="replace_IOS_" value="MinimumOSVersion" />
    <add key="replace_IOSX_" value="MinimumOSVersion" />
    <add key="replace_VERSION_" value="CFBundleShortVersionString,CFBundleVersion" />
    <add key="replace_CRACKER_" value="appleId" />
    <add key="replace_APPNAME_" value="CFBundleName,CFBundleDisplayName,bundleDisplayName" />
  </appSettings>
  <startup>
    <supportedRuntime version="v2.0.50727"/>
  </startup>
  <userSettings>
    <IPA_Sorter.Properties.Settings>
      <setting name="Setting" serializeAs="String">
        <value />
      </setting>
    </IPA_Sorter.Properties.Settings>
  </userSettings>
</configuration>
